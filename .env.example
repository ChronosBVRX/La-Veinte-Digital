# Supabase (público — seguro para el navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI (privado — solo servidor)
OPENAI_API_KEY=

# Bot Python privado (opcional — solo servidor; si no se define, /api/consulta
# usa OpenAI directamente desde Next.js)
BOT_API_URL=
BOT_API_SHARED_SECRET=

# Despliegue (privado — solo servidor)
VERCEL_OIDC_TOKEN=

# Speechify TTS (privado — solo sidecar, nunca NEXT_PUBLIC_*)
SPEECHIFY_API_KEY=
# Overrides opcionales para fijar casting (si no se definen, se elige automáticamente del catálogo)
# SPEECHIFY_VOICE_MALE_1=  # Eduardo
# SPEECHIFY_VOICE_FEMALE_1=  # Andrea
# SPEECHIFY_VOICE_MALE_2=  # Javier Ríos
# SPEECHIFY_VOICE_MALE_3=  # Rodrigo Torres
# SPEECHIFY_VOICE_FEMALE_2=  # Valeria Soto

# LLM local para guion (solo sidecar, Ollama)
LOCAL_LLM_MODEL=qwen3.5:9b
LOCAL_LLM_CONTEXT=16384
LOCAL_LLM_KEEP_ALIVE=5m
OLLAMA_BASE_URL=http://127.0.0.1:11434
