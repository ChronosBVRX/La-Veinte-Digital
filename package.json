{
  "name": "la-veinte-digital",
  "version": "0.002",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/radio-studio"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/copy-vendor.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-vendor.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "e2e": "npx playwright test",
    "e2e:smoke": "npx playwright test e2e/smoke --project=chromium-desktop --project=chromium-public",
    "e2e:full": "npx playwright test",
    "e2e:headed": "npx playwright test --headed",
    "e2e:ui": "npx playwright test --ui",
    "e2e:report": "npx playwright show-report",
    "e2e:debug": "npx playwright test --debug",
    "normativa:bootstrap": "node --no-warnings --import tsx src/features/normativa/cli/bootstrap.ts",
    "normativa:verify": "node --no-warnings --import tsx src/features/normativa/cli/verify.ts",
    "normativa:update": "node --no-warnings --import tsx src/features/normativa/cli/update.ts",
    "normativa:recover": "node --no-warnings --import tsx src/features/normativa/cli/recover-blocked.ts",
    "normativa:index": "node --no-warnings --import tsx src/features/normativa/cli/index.ts",
    "normativa:discover": "node --no-warnings --import tsx src/features/normativa/cli/discover.ts",
    "normativa:report": "node --no-warnings --import tsx src/features/normativa/cli/report.ts",
    "normativa:coverage": "node --no-warnings --import tsx src/features/normativa/cli/coverage-report.ts",
    "normativa:search": "node --no-warnings --import tsx src/features/normativa/cli/search.ts",
    "tts:benchmark-laptop": "node --no-warnings --import tsx src/features/normativa/cli/tts-benchmark.ts",
    "studio:smoke": "bash apps/radio-studio/sidecar/scripts/studio-smoke.sh",
    "sidecar": "bash apps/radio-studio/sidecar/scripts/sidecarctl.sh",
    "test:unit": "npx vitest run packages/radio-core packages/tts-core src/features/normativa/__tests__ apps/radio-studio/sidecar/src/llm/__tests__"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.111.0",
    "edge-tts": "^1.0.1",
    "framer-motion": "^12.43.0",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.27.0",
    "mupdf": "^1.28.0",
    "next": "16.2.12",
    "openai": "^7.0.0",
    "pdfjs-dist": "6.1.200",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "tesseract.js": "7.0.0",
    "tsx": "4.23.12",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/testing-library__jest-dom": "^5.14.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.18"
  }
}