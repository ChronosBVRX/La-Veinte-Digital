      "citations": [], "emotion": "duda"
    },
    {
      "id": "d003", "speaker": "ANDREA",
      "text": "Pero espera, ¿y eso vale aunque sea rotación normal del área?",
      "intent": "interrupt_question",
      "pauseBeforeMs": 40, "pauseAfterMs": 350,
      "energy": 4, "pace": "normal", "canOverlap": false, "transition": null,
