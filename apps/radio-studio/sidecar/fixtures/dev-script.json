    {
      "id": "d001", "speaker": "EDUARDO",
      "text": "A ver, vamos con esto: te cambian el horario de la unidad sin avisarte y sin papel de por medio.",
      "intent": "statement", "pauseBeforeMs": 0, "pauseAfterMs": 300,
      "energy": 3, "pace": "normal", "canOverlap": false, "transition": null,
