# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# runtime vendor regenerado por scripts/copy-vendor.mjs (predev/prebuild)
/public/vendor

# supabase cli temp
/supabase/.temp
/supabase/.branches

# playwright e2e
/playwright-report/
/test-results/
/e2e/.auth/

# Android keystores (never commit)
*.jks
*.keystore
*.b64


# normativa (corpus documental descargado � no versionar originales)
/data/

